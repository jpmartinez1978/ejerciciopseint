Proceso cuatronumeros
		definir num1,num2,num3,num4 Como Real;
		Definir suma , producto Como Real
		Escribir "Digite el Numero 1";
		Leer num1;
		Escribir "Digite el Numero 2";
		Leer num2;
		Escribir "Digite el Numero 3";
		Leer num3;
		Escribir "Digite el Numero 4";
		Leer num4;
		suma<-num1+ num2
		producto<-num3* num4
		
		Escribir "La suma de los dos primeros numers es : ",suma;
		Escribir "El Producto del tercer y cuarto numero es : ",producto;
FinProceso

